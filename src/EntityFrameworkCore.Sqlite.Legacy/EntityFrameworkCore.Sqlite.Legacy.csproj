<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EntityFrameworkCore.Sqlite.Legacy</RootNamespace>
    <AssemblyName>EntityFrameworkCore.Sqlite.Legacy</AssemblyName>
    <Version>$(PluLegacyBridgeVersion)</Version>
    <PackageId>EntityFrameworkCore.Sqlite.Legacy</PackageId>
    <Description>EF Core SQLite via net462 bridge: netstandard2.0 + EF 3.1 ou net10.0 + EF 10 (criptografia legada System.Data.SQLite).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid compiling nested helper project intermediates (Ef31/obj). -->
    <Compile Remove="Ef31\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(PluLegacyBridgeEf10Version)" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Sqlite.LegacyBridge.Protocol\**\*.cs"
             Exclude="..\Sqlite.LegacyBridge.Protocol\bin\**\*;..\Sqlite.LegacyBridge.Protocol\obj\**\*" />
    <Compile Include="..\Sqlite.LegacyBridge.Client\**\*.cs"
             Exclude="..\Sqlite.LegacyBridge.Client\bin\**\*;..\Sqlite.LegacyBridge.Client\obj\**\*" />
    <Compile Include="..\Sqlite.LegacyBridge.Ado\**\*.cs"
             Exclude="..\Sqlite.LegacyBridge.Ado\bin\**\*;..\Sqlite.LegacyBridge.Ado\obj\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\EntityFrameworkCore.Sqlite.Legacy.targets" Pack="true" PackagePath="buildTransitive\EntityFrameworkCore.Sqlite.Legacy.targets" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="build\EntityFrameworkCore.Sqlite.Legacy.targets" />

  <Target Name="PackLegacyHostIntoNupkg" BeforeTargets="GenerateNuspec" DependsOnTargets="Build;BuildLegacySqliteBridgeHost" Condition="Exists('$(MSBuildProjectDirectory)\..\Sqlite.LegacyBridge.Host\Sqlite.LegacyBridge.Host.csproj')">
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\..\Sqlite.LegacyBridge.Host\bin\$(Configuration)\net462\**\*.*"
            Pack="true"
            PackagePath="legacy/" />
    </ItemGroup>
  </Target>

</Project>
