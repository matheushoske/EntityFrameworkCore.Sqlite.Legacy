<!-- Consome só netstandard2.0 + EF 3.1 — para consumidores (ex. PDVLinear.Core) sem NU1605 com o alvo net10/EF10 do projeto principal. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EntityFrameworkCore.Sqlite.Legacy</RootNamespace>
    <AssemblyName>EntityFrameworkCore.Sqlite.Legacy.Ef31</AssemblyName>
    <Version>$(PluLegacyBridgeVersion)</Version>
    <PackageId>EntityFrameworkCore.Sqlite.Legacy.Ef31</PackageId>
    <Description>EF Core 3.1 variant of EntityFrameworkCore.Sqlite.Legacy for netstandard2.0 consumers.</Description>
    <IsPackable>true</IsPackable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SqliteLegacyDbContextOptionsExtensions.cs" Link="SqliteLegacyDbContextOptionsExtensions.cs" />
    <Compile Include="..\LegacySqliteConnectionOptionsBuilder.cs" Link="LegacySqliteConnectionOptionsBuilder.cs" />
    <Compile Include="..\..\Sqlite.LegacyBridge.Protocol\**\*.cs"
             Exclude="..\..\Sqlite.LegacyBridge.Protocol\bin\**\*;..\..\Sqlite.LegacyBridge.Protocol\obj\**\*" />
    <Compile Include="..\..\Sqlite.LegacyBridge.Client\**\*.cs"
             Exclude="..\..\Sqlite.LegacyBridge.Client\bin\**\*;..\..\Sqlite.LegacyBridge.Client\obj\**\*" />
    <Compile Include="..\..\Sqlite.LegacyBridge.Ado\**\*.cs"
             Exclude="..\..\Sqlite.LegacyBridge.Ado\bin\**\*;..\..\Sqlite.LegacyBridge.Ado\obj\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(PluLegacyBridgeEf31Version)" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\build\EntityFrameworkCore.Sqlite.Legacy.targets" Pack="true" PackagePath="buildTransitive\EntityFrameworkCore.Sqlite.Legacy.Ef31.targets" />
  </ItemGroup>

  <Import Project="..\build\EntityFrameworkCore.Sqlite.Legacy.targets" />

</Project>
