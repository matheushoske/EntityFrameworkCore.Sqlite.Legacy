<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PackagedLegacyDir>$(MSBuildThisFileDirectory)..\legacy\</_PackagedLegacyDir>
    <_SourceHostDir>$(MSBuildThisFileDirectory)..\..\Sqlite.LegacyBridge.Host\bin\$(Configuration)\net481\</_SourceHostDir>
    <_HostProject>$(MSBuildThisFileDirectory)..\..\Sqlite.LegacyBridge.Host\Sqlite.LegacyBridge.Host.csproj</_HostProject>
  </PropertyGroup>

  <Target Name="BuildLegacySqliteBridgeHost" Condition="Exists('$(_HostProject)')">
    <MSBuild Projects="$(_HostProject)"
             Properties="Configuration=$(Configuration);TargetFramework=net481"
             Targets="Build" />
  </Target>

  <Target Name="CopyLegacySqliteBridgeHost" AfterTargets="Build" DependsOnTargets="BuildLegacySqliteBridgeHost">
    <PropertyGroup>
      <_HostOutDir Condition="Exists('$(_SourceHostDir)Sqlite.LegacyBridge.Host.exe')">$(_SourceHostDir)</_HostOutDir>
      <_HostOutDir Condition="'$(_HostOutDir)' == '' AND Exists('$(_PackagedLegacyDir)Sqlite.LegacyBridge.Host.exe')">$(_PackagedLegacyDir)</_HostOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_HostFiles Include="$(_HostOutDir)**\*.*" Condition="Exists('$(_HostOutDir)Sqlite.LegacyBridge.Host.exe')" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)legacy" Condition="'@(_HostFiles)' != ''" />
    <Copy SourceFiles="@(_HostFiles)"
          DestinationFiles="@(_HostFiles->'$(OutDir)legacy\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="'@(_HostFiles)' != ''" />
  </Target>

  <Target Name="CopyLegacySqliteBridgeHostPublish" AfterTargets="Publish" DependsOnTargets="BuildLegacySqliteBridgeHost">
    <PropertyGroup>
      <_HostPubDir Condition="Exists('$(_SourceHostDir)Sqlite.LegacyBridge.Host.exe')">$(_SourceHostDir)</_HostPubDir>
      <_HostPubDir Condition="'$(_HostPubDir)' == '' AND Exists('$(_PackagedLegacyDir)Sqlite.LegacyBridge.Host.exe')">$(_PackagedLegacyDir)</_HostPubDir>
    </PropertyGroup>
    <ItemGroup>
      <_HostPub Include="$(_HostPubDir)**\*.*" Condition="Exists('$(_HostPubDir)Sqlite.LegacyBridge.Host.exe')" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)legacy" Condition="'@(_HostPub)' != ''" />
    <Copy SourceFiles="@(_HostPub)"
          DestinationFiles="@(_HostPub->'$(PublishDir)legacy\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="'@(_HostPub)' != ''" />
  </Target>

</Project>
